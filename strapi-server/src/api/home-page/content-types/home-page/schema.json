{
  "kind": "singleType",
  "collectionName": "home_pages",
  "info": {
    "singularName": "home-page",
    "pluralName": "home-pages",
    "displayName": "home-page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "maxLength": 50,
      "required": true
    },
    "description": {
      "type": "text",
      "minLength": 50,
      "maxLength": 250,
      "required": true
    },
    "banner": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "buttonLabel": {
      "type": "string",
      "maxLength": 100,
      "required": true
    },
    "aboutus": {
      "type": "component",
      "component": "homepage.about-us",
      "repeatable": true
    },
    "pricesection": {
      "type": "component",
      "component": "homepage.pricing-section",
      "repeatable": true
    }
  }
}
